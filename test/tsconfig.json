{
	// Compiles src/, tools/ and test/ together so tests can import the parser
	// (tools/) and the generated tables (src/) with full type checking.
	// Output lands in out/test/{src,tools,test}; `pnpm test` runs out/test/test.
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "../out/test",
		"rootDir": "..",
		"types": ["node"]
	},
	"include": [
		"../src/**/*.ts",
		"../tools/**/*.ts",
		"./**/*.ts"
	]
}
