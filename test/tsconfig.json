{
	// Compiles src/, tools/ and test/ together so tests can import the parser
	// (tools/) and the generated tables (src/) with full type checking.
	// Output lands in out/test/{src,tools,test}; `npm test` runs out/test/test.
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2020",
		"lib": ["es2020"],
		"outDir": "../out/test",
		"rootDir": "..",
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"types": ["node"]
	},
	"include": [
		"../src/**/*.ts",
		"../tools/**/*.ts",
		"./**/*.ts"
	]
}
