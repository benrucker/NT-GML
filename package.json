{
	"name": "ntgml",
	"displayName": "Nuclear Throne Together GML",
	"description": "Syntax highlighting and completions for NTGML, the GML dialects used by Nuclear Throne Together mods (legacy .gml and modern .ntgml).",
	"version": "0.1.0",
	"publisher": "benrucker",
	"license": "MIT",
	"icon": "resources/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/benrucker/NT-GML.git"
	},
	"bugs": {
		"url": "https://github.com/benrucker/NT-GML/issues"
	},
	"packageManager": "pnpm@11.12.0",
	"engines": {
		"vscode": "^1.75.0",
		"node": ">=22",
		"pnpm": ">=10"
	},
	"categories": [
		"Other",
		"Programming Languages"
	],
	"keywords": [
		"nuclear throne",
		"nuclear throne together",
		"ntt",
		"gml",
		"gamemaker",
		"modding"
	],
	"activationEvents": [
		"onLanguage:ntgml",
		"onLanguage:ntgml-legacy"
	],
	"main": "./out/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "ntgml-legacy",
				"aliases": [
					"NTGML (legacy .gml)",
					"NTGML legacy"
				],
				"extensions": [
					".gml"
				],
				"configuration": "./data/gml-configuration.json"
			},
			{
				"id": "ntgml",
				"aliases": [
					"NTGML",
					"Nuclear Throne Together GML"
				],
				"extensions": [
					".ntgml"
				],
				"configuration": "./data/gml-configuration.json"
			},
			{
				"id": "ntt-main",
				"aliases": [
					"NTT command file",
					"NTT main.txt"
				],
				"filenames": [
					"main.txt",
					"main.cfg"
				],
				"filenamePatterns": [
					"main[0-9]*.txt"
				],
				"configuration": "./data/ntt-main-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "ntgml-legacy",
				"scopeName": "source.ntgml.legacy",
				"path": "./syntaxes/ntgml-legacy.tmLanguage.json"
			},
			{
				"language": "ntgml",
				"scopeName": "source.ntgml",
				"path": "./syntaxes/ntgml.tmLanguage.json"
			},
			{
				"language": "ntt-main",
				"scopeName": "source.ntt-main",
				"path": "./syntaxes/ntt-main.tmLanguage.json"
			}
		]
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"vscode:prepublish": "pnpm run clean && pnpm run compile",
		"clean": "node -e \"fs.rmSync('out', { recursive: true, force: true })\"",
		"compile": "tsc -p ./",
		"compile:tools": "tsc -p tools",
		"compile:test": "tsc -p test",
		"build": "pnpm run compile && pnpm run compile:tools && pnpm run compile:test",
		"watch": "tsc -watch -p ./",
		"lint": "eslint .",
		"typecheck": "tsc -p test --noEmit",
		"test": "pnpm run build && node --test \"out/test/test/**/*.test.js\"",
		"gen:api": "pnpm run compile:tools && node out/tools/generate-api.js",
		"gen:grammar": "pnpm run compile:tools && node out/tools/generate-grammar.js",
		"gen": "pnpm run gen:api && pnpm run gen:grammar",
		"package": "vsce package --no-dependencies"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.0.0",
		"@types/vscode": "^1.75.0",
		"@vscode/vsce": "^3.9.2",
		"eslint": "^10.10.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.69.0",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.3.2"
	}
}
