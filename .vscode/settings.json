{
	"files.exclude": {
		"out": false
	},
	"search.exclude": {
		"out": true
	},
	// Scripts are run through pnpm (tasks.json, the npm scripts view, etc.).
	"npm.packageManager": "pnpm",
	// The build task in tasks.json replaces tsc auto-detection.
	"typescript.tsc.autoDetect": "off",
	"typescript.tsdk": "node_modules/typescript/lib"
}
